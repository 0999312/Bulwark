[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scenes/ui/pause_panel.gd" id="1_panel"]
[ext_resource type="FontFile" path="res://assets/fonts/MiSans-Semibold.ttf" id="2_font"]

[node name="PausePanel" type="Control"]
process_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_panel")

[node name="Center" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]

[node name="VBox" type="VBoxContainer" parent="Center/Panel"]
theme_override_constants/separation = 12

[node name="TitleLabel" type="Label" parent="Center/Panel/VBox"]
horizontal_alignment = 1
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 30
text = "暂停中"

[node name="SubLabel" type="Label" parent="Center/Panel/VBox"]
horizontal_alignment = 1
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 15
text = "异变体可不会等你喝完这口水。（Esc 继续）"

[node name="ResumeButton" type="Button" parent="Center/Panel/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(220, 0)
text = "继续"

[connection signal="pressed" from="Center/Panel/VBox/ResumeButton" to="." method="_on_resume_pressed"]
